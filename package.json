{
  "name": "personal-learning-companion",
  "version": "0.7.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:ai": "cd ai-backend && python -m uvicorn app.main:app --reload --port 8000",
    "test:ai": "cd ai-backend && python -m pytest -q",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
