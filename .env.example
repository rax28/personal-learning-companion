VITE_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
AI_BACKEND_URL=http://localhost:8000

# Choose: gemini, openai, or ollama
ONLINE_PROVIDER=ollama

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_WEB_SEARCH=true

LOCAL_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional Google Classroom integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:4000/oauth/google/classroom/callback
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://plc:plc@localhost:5432/plc
REDIS_URL=redis://localhost:6379/0
AI_INTERNAL_TOKEN=change-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

COOKIE_SECURE=false
